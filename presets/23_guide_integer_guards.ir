# Guide trap: out-of-range integer arithmetic must not become constants.
# Expected under the guide's rules: keep every arithmetic instruction below.
# Results are printed so DCE cannot hide missing folding guards.
# Overflow behavior in the current compiler can differ from the tutorial.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : int = add int 2147483647, int 1
  v1 : int = sub int -2147483648, int 1
  v2 : int = mul int 1073741824, int 2
  call print, v0, v1, v2
  ret unit
