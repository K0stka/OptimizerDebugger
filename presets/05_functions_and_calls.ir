# User function calls and built-ins. Interprocedural folding is not
# implemented, so the calls survive optimization.
.entrypoint main

.func double_it : int
.param @n : int
.entry 0

.block 0
  v0 : int = load @n
  v1 : int = mul v0, int 2
  ret v1

.func main : unit
.entry 0

.block 0
  v0 : int = call double_it, int 21
  v1 : string = call chr, v0
  call print, v1
  ret unit
