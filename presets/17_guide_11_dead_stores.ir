# Guide step 11: remove stores only when the slot has no remaining loads.
# Expected: all scratch stores vanish; the carry store and next-block load stay.
# The readInt side effect stays even when its scratch store disappears.
.entrypoint main

.func main : unit
.local @scratch : int
.local @carry : int
.entry 0

.block 0
  v0 : int = call readInt
  store @scratch v0
  store @scratch int 99
  store @carry int 7
  call print, string "next block"
  jump 1

.block 1
  v1 : int = load @carry
  call print, v1
  ret unit
