# Guide step 6: identities with unknown inputs, not just constant arithmetic.
# Expected: neutral operations reuse v0/v7; integer x-x and x*0 become 0;
# x==x becomes true. Reading calls must survive even if results become unused.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : int = call readInt
  v1 : int = add v0, int 0
  v2 : int = sub v1, int 0
  v3 : int = mul v2, int 1
  v4 : int = idiv v3, int 1
  v5 : int = sub v0, v0
  v6 : bool = eq v0, v0
  v7 : string = call readLine
  v8 : string = concat v7, string ""
  v9 : int = call readInt
  v10 : int = mul v9, int 0
  call print, v4, v5, v6, v8, v10
  ret unit
