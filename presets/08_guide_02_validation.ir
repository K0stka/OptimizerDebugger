# Guide step 2: valid slots, targets, and sparse textual value ids.
# Expected: both paths remain valid; v7 and v42 are legal textual ids.
# The text parser preserves ids and reserves value_count through the highest id.
# Malformed counterparts live in tests/fixtures/guide/ (not normal presets).
.entrypoint main

.func main : unit
.local @input : int
.entry 0

.block 0
  v7 : int = call readInt
  store @input v7
  v42 : bool = ge v7, int 0
  branch v42 ? 1 : 2

.block 1
  v50 : int = load @input
  call print, v50
  ret unit

.block 2
  call print, string "negative"
  ret unit
