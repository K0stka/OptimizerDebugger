# Guide step 15: an allocation/cleanup workload, NOT fault injection.
# Exercises folded strings with zero/multiple uses, forwarding, and dead blocks.
# Expected: no crash; "owned buffer" reaches both print arguments independently.
# Failing the nth allocation requires the compiler's C test harness; see GUIDE.md.
.entrypoint main

.func main : unit
.local @message : string
.entry 0

.block 0
  v0 : string = concat string "owned ", string "buffer"
  store @message v0
  v1 : string = load @message
  call print, v1, v1
  v2 : string = concat string "unused ", string "allocation"
  branch bool true ? 1 : 2

.block 1
  call print, v0
  ret unit

.block 2
  v3 : string = concat string "dead ", string "block"
  call print, v3
  ret unit
