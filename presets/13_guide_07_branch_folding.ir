# Guide step 7: true/false conditions and equal branch targets.
# Expected: all three branches become jumps (0 -> 1 -> 3 -> 5).
# The readBool call survives even though its condition no longer matters.
.entrypoint main

.func main : unit
.entry 0

.block 0
  branch bool true ? 1 : 2

.block 1
  branch bool false ? 2 : 3

.block 2
  call print, string "unreachable"
  ret unit

.block 3
  v0 : bool = call readBool
  branch v0 ? 5 : 5

.block 4
  call print, string "also unreachable"
  ret unit

.block 5
  call print, string "taken"
  ret unit
