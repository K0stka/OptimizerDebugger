# Guide step 10: constants, repeated loads, and store invalidation in one block.
# Expected print arguments after forwarding: v0, v0, 42, 9, "still known", 9.
# A call does not mutate this function's slots; a later store changes the map.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : int = call readInt
  call inspect, v0
  ret unit

.func inspect : unit
.param @input : int
.local @x : int
.entry 0

.block 0
  v0 : int = load @input
  v1 : int = load @input
  store @x int 42
  v2 : int = load @x
  store @x int 9
  v3 : int = load @x
  call print, v0, v1, v2, v3
  call print, string "still known"
  v4 : int = load @x
  call print, v4
  ret unit
