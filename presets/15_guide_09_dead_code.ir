# Guide step 9: dead dependency chains disappear to a fixpoint.
# Expected: v1/v2/v3 and the unused load vanish. Both reading calls survive.
# Return values, call arguments, and stores must all count as uses.
.entrypoint main

.func main : unit
.local @unused : int
.entry 0

.block 0
  v0 : int = call readInt
  v1 : int = add v0, int 5
  v2 : int = mul v1, int 3
  v3 : double = int2double v2
  v4 : int = load @unused
  v5 : string = call readLine
  call print, v0
  ret unit
