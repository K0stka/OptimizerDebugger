# Guide traps: signed zero, NaN, infinity, and floating division by zero.
# Expected: no x+0.0, x-(-0.0), x*0.0, x-x, or self-comparison identities.
# Unknown x might be NaN/infinity/-0.0; only x-(+0.0) is a safe subtraction identity.
# Constant 1.0/0.0 stays for the runtime error, never becomes infinity.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : double = call readDouble
  v1 : double = add v0, double 0.0
  v2 : double = sub v0, double -0.0
  v3 : double = mul v0, double 0.0
  v4 : double = sub v0, v0
  v5 : bool = eq v0, v0
  v6 : bool = ne v0, v0
  v7 : double = sub v0, double 0.0
  v8 : double = div double 1.0, double 0.0
  call print, v1, v2, v3, v4, v5, v6, v7, v8
  ret unit
