# Guide outlook: opportunities beyond the tutorial, NOT promised current folds.
# Cross-block propagation could discover @x=21 in block 1.
# Coalescing could merge 0->1; duplicate-store analysis could drop one @x store.
# A conversion/comparison peephole could compare the integer input with 10.
# A read-only parameter could bypass its stack slot during code generation.
.entrypoint main

.func main : unit
.local @x : int
.entry 0

.block 0
  store @x int 21
  jump 1

.block 1
  v0 : int = load @x
  v1 : int = call readInt
  store @x v1
  store @x v1
  call inspect, v0
  jump 2

.block 2
  v2 : int = load @x
  call print, v2
  ret unit

.func inspect : unit
.param @n : int
.entry 0

.block 0
  v0 : int = load @n
  v1 : double = int2double v0
  v2 : bool = lt v1, double 10.0
  call print, v2
  ret unit
