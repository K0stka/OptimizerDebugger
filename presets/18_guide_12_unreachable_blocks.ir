# Guide step 12: remove dead blocks and remap every target plus the entrypoint.
# Expected: old blocks 0/1 vanish, entry 2 becomes 0, branch 3/4 becomes 1/2,
# and both jumps to old block 5 become jumps to block 3.
.entrypoint main

.func main : unit
.entry 2

.block 0
  call print, string "dead zero"
  jump 1

.block 1
  call print, string "dead one"
  ret unit

.block 2
  v0 : bool = call readBool
  branch v0 ? 3 : 4

.block 3
  call print, string "left"
  jump 5

.block 4
  call print, string "right"
  jump 5

.block 5
  call print, string "joined"
  ret unit
