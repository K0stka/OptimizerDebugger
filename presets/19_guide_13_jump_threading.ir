# Guide step 13: redirect both branch targets through empty jump chains.
# Expected: branch targets reach old blocks 4/5 directly; empty 1/2/3 vanish.
# Block 4 has a print and must not be treated as an empty forwarding block.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : bool = call readBool
  branch v0 ? 1 : 3

.block 1
  jump 2

.block 2
  jump 4

.block 3
  jump 5

.block 4
  call print, string "left"
  jump 5

.block 5
  call print, string "finish"
  ret unit
