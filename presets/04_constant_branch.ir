# Constant-condition branch: v0 folds to bool true and the branch folds
# into an unconditional jump to the taken target.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : bool = lt int 1, int 2
  branch v0 ? 1 : 2

.block 1
  call print, string "taken"
  ret unit

.block 2
  call print, string "not taken"
  ret unit
