# Guide trap: division by zero must remain a runtime error, not be evaluated
# by the optimizer. Expected: the IDIV survives because print uses its result.
# This can reproduce a crash in a compiler that lacks the folding guard.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : int = idiv int 12, int 0
  call print, v0
  ret unit
