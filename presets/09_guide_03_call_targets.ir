# Guide step 3: forward user-function calls, a builtin, and recursion.
# Expected: main -> countdown -> announce resolve, including the self-call.
# The unknown-call negative fixture checks text-parser rejection separately.
.entrypoint main

.func main : unit
.entry 0

.block 0
  v0 : int = call countdown, int 3
  call print, v0
  ret unit

.func countdown : int
.param @n : int
.entry 0

.block 0
  v0 : int = load @n
  v1 : bool = le v0, int 0
  branch v1 ? 1 : 2

.block 1
  call announce
  ret int 0

.block 2
  v2 : int = sub v0, int 1
  v3 : int = call countdown, v2
  ret v3

.func announce : unit
.entry 0

.block 0
  call print, string "done"
  ret unit
